            9px 16px 0 #111;

        background: var(--yellow-light);
    }

    .subsection-number {
        font-family: 'Press Start 2P', cursive;

        color: var(--red);

        font-size: 14px;

        margin-bottom: 18px;
    }

    .subsection-name {
        font-family: 'Press Start 2P', cursive;

        font-size: 15px;

        line-height: 1.6;
    }


    /* =========================
