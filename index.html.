<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>The Portfolio | MMW</title>

<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">

<style>

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --sky-top: #4bb8f5;
        --sky-mid: #79d5f7;
        --sky-bottom: #bceeff;

        --white: #ffffff;
        --black: #111111;

        --red: #e83232;
        --red-dark: #a91f27;
        --red-light: #ff5959;

        --yellow: #ffd83d;
        --yellow-light: #fff4a8;
        --yellow-dark: #bd8c00;

        --green: #55b83f;
        --green-dark: #367f2e;

        --brown: #925126;
        --brown-dark: #633318;

        --blue-dark: #217fb0;
        --blue-light: #dff7ff;
    }

    body {
        font-family: 'VT323', monospace;
        background: var(--sky-top);
        color: var(--black);
        overflow-x: hidden;
    }

    button {
        font-family: 'Press Start 2P', cursive;
        cursor: pointer;
    }


    /* =========================
       GENERAL SCREEN
    ========================= */

    .screen {
        min-height: 100vh;
        width: 100%;
        display: none;
        position: relative;
        overflow: hidden;
    }

    .screen.active {
        display: flex;
    }


    /* =========================
       START SCREEN
    ========================= */

    #startScreen {
        min-height: 100vh;

        background:
            linear-gradient(
                to bottom,
                var(--sky-top) 0%,
                var(--sky-mid) 58%,
                var(--sky-bottom) 100%
            );

        flex-direction: column;
        justify-content: center;
        align-items: center;

        padding: 30px;
    }


    /* =========================
       CLOUDS
    ========================= */

    .cloud {
        position: absolute;
        background: var(--white);

        width: 100px;
        height: 35px;

        border-radius: 30px;

        box-shadow:
            25px -15px 0 var(--white),
            55px 0 0 var(--white),
            30px 15px 0 var(--white);

        opacity: 0.92;
    }

    .cloud1 {
        top: 10%;
        left: 7%;
    }

    .cloud2 {
        top: 18%;
        right: 8%;
        transform: scale(0.8);
    }

    .cloud3 {
        top: 42%;
        left: 3%;
        transform: scale(0.6);
    }


    /* =========================
       BLOCKS
    ========================= */

    .block {
        position: absolute;

        width: 55px;
        height: 55px;

        background:
            linear-gradient(
                135deg,
                #f0a442,
                #d27c25
            );

        border: 5px solid #8d4e1d;

        box-shadow:
            inset 0 0 0 4px #f5bd5d,
            4px 4px 0 rgba(0, 0, 0, 0.18);
    }

    .block1 {
        top: 15%;
        left: 25%;
    }

    .block2 {
        top: 28%;
        right: 22%;
    }

    .question-block {
        background:
            linear-gradient(
                135deg,
                #ffe15a,
                #f1bd22
            );

        border-color: #9c7010;
    }

    .question-block::after {
        content: "?";

        color: white;

        font-family: 'Press Start 2P', cursive;

        font-size: 25px;

        position: absolute;

        top: 10px;
        left: 13px;

        text-shadow: 2px 2px 0 #9c7010;
    }


    /* =========================
       COINS
    ========================= */

    .coin {
        position: absolute;

        width: 25px;
        height: 35px;

        background:
            linear-gradient(
                to right,
                #f6c72f,
                #ffe66d,
                #f6c72f
            );

        border: 4px solid var(--yellow-dark);

        border-radius: 50%;

        box-shadow:
            inset 0 0 0 3px #fff0a0,
            3px 3px 0 rgba(0, 0, 0, 0.15);
    }

    .coin1 {
        top: 24%;
        left: 16%;
    }

    .coin2 {
        top: 35%;
        right: 12%;
    }

    .coin3 {
        top: 12%;
        right: 35%;
    }


    /* =========================
       STARS
    ========================= */

    .star {
        position: absolute;

        font-size: 45px;

        color: var(--yellow);

        text-shadow:
            4px 4px 0 #9c7010,
            0 0 10px rgba(255, 216, 61, 0.45);
    }

    .star1 {
        top: 8%;
        right: 30%;
    }

    .star2 {
        bottom: 20%;
        left: 12%;
    }


    /* =========================
       START CONTENT
    ========================= */

    .start-content {
        z-index: 10;

        text-align: center;

        max-width: 1000px;
    }

    .small-title {
        font-family: 'Press Start 2P', cursive;

        font-size: 18px;

        margin-bottom: 25px;

        color: white;

        text-shadow:
            4px 4px 0 #222,
            0 0 8px rgba(0, 0, 0, 0.15);
    }

    .main-title {
        font-family: 'Press Start 2P', cursive;

        font-size: clamp(35px, 7vw, 80px);

        color: white;

        text-shadow:
            7px 7px 0 #222,
            10px 10px 0 var(--red-dark);

        margin-bottom: 25px;
    }

    .subtitle {
        font-family: 'Press Start 2P', cursive;

        font-size: clamp(15px, 2vw, 25px);

        color: white;

        text-shadow:
            4px 4px 0 #222;

        margin-bottom: 35px;
    }


    /* =========================
       PLAYER CARD
    ========================= */

    .player-card {
        display: inline-block;

        background:
            linear-gradient(
                to bottom,
                #ffffff,
                #eefaff
            );

        border: 6px solid var(--black);

        padding: 20px 30px;

        box-shadow:
            10px 10px 0 var(--black),
            inset 0 0 0 3px #d7f4ff;

        margin-bottom: 35px;
    }

    .player-name {
        font-family: 'Press Start 2P', cursive;

        font-size: 16px;

        margin-bottom: 12px;
    }

    .player-course {
        font-size: 22px;
    }

    .player-project {
        font-size: 20px;

        margin-top: 5px;
    }


    /* =========================
       MAIN BUTTON
    ========================= */

    .start-button {
        background:
            linear-gradient(
                to bottom,
                var(--red-light),
                var(--red)
            );

        color: white;

        border: 6px solid var(--black);

        padding: 20px 30px;

        font-size: 15px;

        box-shadow:
            8px 8px 0 var(--black);

        transition: 0.15s;
    }

    .start-button:hover {
        transform: translate(4px, 4px);

        box-shadow:
            4px 4px 0 var(--black);
    }

    .start-button:active {
        transform: translate(8px, 8px);

        box-shadow: none;
    }


    /* =========================
       GROUND
    ========================= */

    .ground {
        position: absolute;

        bottom: 0;

        width: 100%;

        height: 90px;

        background:
            linear-gradient(
                to bottom,
                var(--green) 0px,
                var(--green) 25px,
                var(--brown) 25px,
                var(--brown) 100%
            );

        border-top: 7px solid var(--black);
    }

    .grass-pattern {
        position: absolute;

        top: 0;

        width: 100%;
        height: 25px;

        background:
            repeating-linear-gradient(
                90deg,
                #69bd45 0px,
                #69bd45 25px,
                #4c9632 25px,
                #4c9632 32px
            );
    }


    /* =========================
       WORLD SCREEN
    ========================= */

    #worldScreen {
        min-height: 100vh;

        background:
            linear-gradient(
                to bottom,
                var(--sky-top),
                var(--sky-mid) 55%,
                var(--sky-bottom)
            );

        flex-direction: column;

        align-items: center;

        padding: 70px 30px 100px;
    }

    .world-header {
        font-family: 'Press Start 2P', cursive;

        color: white;

        font-size: clamp(30px, 5vw, 55px);

        text-shadow:
            6px 6px 0 #222,
            0 0 10px rgba(0, 0, 0, 0.12);

        margin-bottom: 60px;

        text-align: center;
    }


    /* =========================
       WORLD CARDS
    ========================= */

    .world-container {
        display: grid;

        grid-template-columns: repeat(3, 1fr);

        gap: 35px;

        max-width: 1200px;

        width: 100%;

        z-index: 5;
    }

    .world-card {
        min-height: 300px;

        background:
            linear-gradient(
                to bottom,
                #ffffff,
                #eefaff
            );

        border: 7px solid var(--black);

        box-shadow:
            12px 12px 0 var(--black);

        display: flex;

        flex-direction: column;

        justify-content: center;

        align-items: center;

        padding: 25px;

        text-align: center;

        transition: 0.15s;

        position: relative;

        overflow: hidden;
    }

    .world-card::before {
        content: "";

        position: absolute;

        top: 0;
        left: 0;

        width: 100%;
        height: 8px;

        background:
            linear-gradient(
                90deg,
                var(--red),
                var(--yellow),
                var(--green)
            );
    }

    .world-card:hover {
        transform: translateY(-8px);

        box-shadow:
            12px 20px 0 var(--black);
    }

    .world-number {
        font-family: 'Press Start 2P', cursive;

        font-size: 20px;

        margin-bottom: 30px;

        color: var(--red);
    }

    .world-title {
        font-family: 'Press Start 2P', cursive;

        font-size: 20px;

        line-height: 1.7;
    }

    .world-icon {
        font-size: 60px;

        margin-bottom: 25px;

        filter:
            drop-shadow(4px 4px 0 rgba(0, 0, 0, 0.15));
    }


    /* =========================
       WORLD 1
    ========================= */

