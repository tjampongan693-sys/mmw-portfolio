    }

    .subsection-page.active {
        display: flex;
    }

    .subsection-page-header {
        text-align: center;

        margin-bottom: 35px;

        max-width: 1100px;
    }

    .subsection-page-number {
        font-family: 'Press Start 2P', cursive;

        color: var(--red);

        font-size: 14px;

        margin-bottom: 20px;
    }

    .subsection-page-title {
        font-family: 'Press Start 2P', cursive;

        font-size: clamp(18px, 3vw, 32px);

        color: white;

        text-shadow:
            5px 5px 0 #222;

        line-height: 1.6;
    }


    /* =========================
       ANSWER BOX
    ========================= */

    .answer-box {
        width: 100%;

        max-width: 1000px;

        background:
            linear-gradient(
                to bottom,
                #ffffff,
                #f4fcff
            );

        border: 7px solid #111;

        box-shadow:
            12px 12px 0 #111;

        padding: 35px 40px;

        font-family: 'VT323', monospace;

        font-size: 24px;

        line-height: 1.5;

        text-align: justify;
    }

    .answer-box p {
        margin-bottom: 22px;
    }

    .answer-box p:last-child {
        margin-bottom: 0;
    }


    /* =========================
       PICTURE
    ========================= */

    .picture-placeholder {
        width: 100%;

        max-width: 800px;

        min-height: 350px;

        background: white;

        border: 7px solid #111;

        box-shadow:
            12px 12px 0 #111;

        display: flex;

        justify-content: center;

        align-items: center;

        font-family: 'Press Start 2P', cursive;

        font-size: 18px;

        text-align: center;

        padding: 30px;
    }

    .picture-placeholder img {
        max-width: 100%;

        height: auto;

        display: block;
    }


    /* =========================
       BACK BUTTON
    ========================= */

    .back-button {
        margin-top: 40px;

        background:
            linear-gradient(
                to bottom,
                var(--red-light),
                var(--red)
            );

        color: white;

        border: 5px solid #111;

        padding: 15px 22px;

        font-size: 12px;

        box-shadow:
            7px 7px 0 #111;

        transition: 0.15s;
    }

    .back-button:hover {
        transform: translate(3px, 3px);

        box-shadow:
            4px 4px 0 #111;
    }


    /* =========================
       HOME BUTTON
    ========================= */

    .home-button {
        margin-top: 40px;

        background:
            linear-gradient(
                to bottom,
                #ffe96a,
                #f3bd20
            );

        color: #111;

        border: 5px solid #111;

        padding: 15px 22px;

        font-size: 12px;

        box-shadow:
            7px 7px 0 #111;

        transition: 0.15s;
    }

    .home-button:hover {
        transform: translate(3px, 3px);

        box-shadow:
            4px 4px 0 #111;

        background:
            linear-gradient(
                to bottom,
                #fff18c,
                #ffd23f
            );
    }

    .home-button:active {
        transform: translate(7px, 7px);

        box-shadow: none;
    }


    /* =========================
