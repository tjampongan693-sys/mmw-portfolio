        width: 70px;
        height: 100px;

        background: #3dbd3d;

        border: 6px solid #111;

        bottom: 70px;

        right: 8%;
    }

    .pipe-top {
        position: absolute;

        width: 90px;
        height: 30px;

        background: #48d348;

        border: 6px solid #111;

        left: -16px;

        top: -25px;
    }


